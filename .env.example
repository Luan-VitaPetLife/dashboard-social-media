PORT=3000
# Seguidores/curtidas não mudam minuto a minuto — sync a cada 12h já é mais que suficiente.
SYNC_INTERVAL_MINUTES=720
# Stories vivem só 24h e somem da API assim que expiram — precisa de um ciclo bem mais curto
# que o sync normal pra ter chance de capturar cada um antes que suma.
STORY_SYNC_INTERVAL_MINUTES=120

# Login único compartilhado (liga/desliga em Configurações, desligado por padrão). Sem essa
# variável, o toggle de login recusa ligar (trava de segurança — senão ninguém conseguiria
# entrar de novo). SESSION_SECRET assina o cookie de sessão; se ausente, cai pra
# DASHBOARD_PASSWORD como segredo de assinatura (recomendado configurar os dois em produção).
DASHBOARD_PASSWORD=
SESSION_SECRET=

# As variáveis abaixo alimentam src/registry.js (empresa → marca → país → conta). Hoje existem
# duas marcas: Coco and Luna (Brasil + Estados Unidos) e Yucaloo (Brasil + Estados Unidos).
# Adicionar uma marca ou país novo significa acrescentar um objeto em registry.js + as env vars
# correspondentes.
#
# IMPORTANTE — o token da Meta é POR MARCA, não global. Cada marca vive no seu próprio Business
# Manager, então cada uma precisa do seu próprio System User Token. A Coco and Luna mantém os
# nomes históricos das variáveis (META_ACCESS_TOKEN, META_IG_ACCOUNT_ID_BR, ...) porque já está
# em produção; marcas novas usam o padrão META_<MARCA>_*.
#
# Uma marca sem token tem TODAS as contas removidas do registry (mesma regra já usada pra conta
# sem metaId): ela continua aparecendo no seletor, marcada como não conectada, em vez de sumir da
# interface ou produzir erro de API.

# Ausente = usa data/db.json local (some a cada deploy no Railway, sem Volume). Presente =
# usa MongoDB Atlas — tier grátis M0 (512MB), fora do orçamento medido do Railway.
# String de conexão do cluster, ex: mongodb+srv://user:senha@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
MONGODB_DB=dashboard_social

# Mesmo System User Token já usado no dashboard principal (live-dashboard) — as 4 contas
# abaixo vivem no mesmo Business Manager, então um token só serve pras quatro.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v20.0

# IDs das contas comerciais do Instagram (Business/Creator, vinculadas a uma Página do Facebook).
# Pegar via Graph API Explorer: GET /me/accounts?fields=id,name,instagram_business_account{id,username}
META_IG_ACCOUNT_ID_BR=
META_IG_ACCOUNT_ID_US=

# IDs das Páginas do Facebook (mesma chamada acima, campo "id" de cada item de /me/accounts).
META_FB_PAGE_ID_BR=
META_FB_PAGE_ID_US=

# Contas de anúncio (mesmo Business Manager do projeto de vendas ../dashboard, reaproveita os
# mesmos valores de META_AD_ACCOUNT_ID/META_US_AD_ACCOUNT_ID de lá) — usadas só pra identificar
# conteúdo impulsionado na ficha de conteúdo (nunca gasto/ROAS, fora do escopo do Social Media).
META_AD_ACCOUNT_ID_BR=
META_AD_ACCOUNT_ID_US=

# ── Yucaloo ────────────────────────────────────────────────────────────────────────────────
# Business Manager SEPARADO do da Coco and Luna — precisa do seu próprio System User Token, com
# as mesmas permissões do token acima: instagram_basic, instagram_manage_insights,
# pages_show_list, pages_read_engagement, read_insights e (só pra marcar conteúdo impulsionado)
# ads_read. Enquanto estas variáveis estiverem vazias, a Yucaloo aparece na dashboard como
# "não conectada" e nada quebra.
META_YUCALOO_ACCESS_TOKEN=

# Mesma chamada usada pra Coco and Luna, mas com o token da Yucaloo:
# GET /me/accounts?fields=id,name,instagram_business_account{id,username}
# O "id" de cada item é a Página do Facebook; o "instagram_business_account.id" é o Instagram.
META_YUCALOO_IG_ACCOUNT_ID_BR=
META_YUCALOO_IG_ACCOUNT_ID_US=
META_YUCALOO_FB_PAGE_ID_BR=
META_YUCALOO_FB_PAGE_ID_US=

# Opcionais — só pra marcar conteúdo impulsionado (orgânico × pago) na ficha de conteúdo.
# Sem elas, tudo da Yucaloo aparece como orgânico.
META_YUCALOO_AD_ACCOUNT_ID_BR=
META_YUCALOO_AD_ACCOUNT_ID_US=

# Cliques do cardápio de links: origens autorizadas a mandar evento pra /api/clicks/collect,
# separadas por vírgula (esquema + domínio, sem barra no fim). Vazio = nenhuma origem externa
# passa, então a coleta fica desligada na prática. Inclua o domínio público da loja e, se for
# testar pelo editor de temas, também o *.myshopify.com.
# Ex: https://yucaloo.com.br,https://sualoja.myshopify.com
CLICKS_ALLOWED_ORIGINS=

# Marca e mercado donos dos cliques quando a página não manda `brandId`/`countryId`. A section do
# cardápio manda os dois, e uma tela JÁ CONHECIDA é atribuída automaticamente a quem já é dono
# dela — então estas variáveis só entram em cena pra uma tela nova de uma página que ainda não
# foi atualizada. Sem nada disso, a coleta recusa o evento com 400 em vez de escolher um padrão
# qualquer: misturar clique da loja errada corrompe os dados em silêncio.
# Precisam ser ids cadastrados em src/registry.js. Ex: yucaloo / br
CLICKS_DEFAULT_BRAND=
CLICKS_DEFAULT_COUNTRY=

# Resumo em texto (ficha D+7), Social Listening e relatórios automáticos — ver src/ai.js.
# Conta de API separada da assinatura Claude Pro (console.anthropic.com, não claude.ai).
ANTHROPIC_API_KEY=
